{
  "name": "chit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "service"
  ],
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test:contracts": "forge test",
    "diana:accounts": "bun scripts/diana.ts accounts",
    "diana:status": "bun scripts/diana.ts status",
    "diana:register": "bun scripts/diana.ts register",
    "diana:fund": "bun scripts/diana.ts fund",
    "diana:windows": "bun scripts/diana.ts windows",
    "diana:deploy": "bun scripts/diana.ts deploy",
    "diana:demo": "bun scripts/diana.ts demo",
    "build:contracts": "forge build",
    "service:dev": "bun service/src/local.ts",
    "build:service": "bun build service/src/worker.ts --target browser --format esm --outfile service/dist/worker.js"
  },
  "dependencies": {
    "@chit/core": "workspace:*",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qoresign": "0.2.0",
    "@qorechain/sdk": "^0.14.0",
    "viem": "^2.58.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vite-plus": "1.8.0"
  }
}
