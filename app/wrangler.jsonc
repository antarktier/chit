{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chit",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "chit.antarktier.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
